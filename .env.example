# Contoh saja; jalankan npm run setup:local untuk membuat .env privat dengan nilai acak.
POSTGRES_PASSWORD=ganti-dengan-password-acak-hex
CREDENTIAL_ENCRYPTION_KEY=ganti-dengan-kunci-base64-32-byte
WEB_PORT=3000
# DATABASE_URL di dalam container disusun oleh compose.yaml; database tidak dipublikasikan ke host.
