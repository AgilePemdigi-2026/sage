{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["apps/worker/**/*.ts", "packages/**/*.ts", "scripts/**/*.ts", "tests/*.test.ts"],
  "exclude": ["node_modules", "packages/database/generated", "tests/fixtures"]
}
