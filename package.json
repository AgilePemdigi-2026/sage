{
  "name": "sage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "npm run dev --workspace @sage/web",
    "build": "npm run generate --workspace @sage/database && npm run build --workspace @sage/web",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @sage/web",
    "lint": "eslint .",
    "test": "tsx --test tests/environment.test.ts tests/fixtures.test.ts tests/contracts.test.ts tests/analyzer-js.test.ts tests/analyzer-php.test.ts tests/queue.test.ts tests/graph-foundation.test.ts tests/ui-foundation.test.ts tests/stage-runner.test.ts tests/github-app-bootstrap.test.ts tests/oauth-database.test.ts tests/github-auth.test.ts tests/github-repositories.test.ts tests/repository-handlers.test.ts tests/repository-target.test.ts tests/history.test.ts tests/history-handlers.test.ts tests/history-ui.test.ts tests/target-handlers.test.ts tests/submission-handlers.test.ts tests/snapshot-storage.test.ts tests/snapshot-archive.test.ts tests/snapshot-provider.test.ts tests/source-analysis.test.ts",
    "db:generate": "npm run generate --workspace @sage/database",
    "db:migrate": "npm run migrate --workspace @sage/database",
    "worker": "tsx apps/worker/src/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:browser": "tsx scripts/browser-smoke.ts",
    "fixtures:verify": "tsx scripts/verify-fixtures.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:data",
    "test:data": "tsx --test tests/database.test.ts",
    "test:data:integration": "tsx --test tests/database.integration.ts",
    "test:ui": "tsx scripts/test-ui-foundation.ts",
    "test:graph": "tsx scripts/test-graph-foundation.ts",
    "test:queue:integration": "tsx --test tests/queue.integration.ts",
    "test:stages:integration": "tsx --test --test-concurrency=1 tests/stage-runner.integration.ts tests/stage-runner-lifecycle.integration.ts",
    "test:ui:baseline": "tsx scripts/test-ui-baseline.ts",
    "setup:github": "node scripts/setup-github-app.mjs",
    "test:oauth:integration": "tsx --test --test-concurrency=1 tests/oauth-database.integration.ts",
    "test:auth:http": "tsx scripts/test-github-auth-http.ts",
    "test:repositories:live": "tsx scripts/test-repository-provider-live.ts",
    "test:repositories:http": "tsx scripts/test-repository-http.ts",
    "test:target:http": "tsx scripts/test-target-http.ts",
    "test:history:http": "tsx scripts/test-history-http.ts",
    "test:target:ui": "tsx scripts/test-target-ui.ts",
    "test:snapshot:integration": "tsx --test --test-concurrency=1 tests/submission-queue.integration.ts tests/snapshot-handler.integration.ts",
    "test:snapshot:live": "tsx scripts/test-snapshot-live.ts",
    "test:source:integration": "tsx --test --test-concurrency=1 tests/source-stages.integration.ts",
    "test:history:integration": "tsx --test tests/history.integration.ts",
    "test:figma:ui": "tsx scripts/test-figma-ui.ts",
    "test:auth:ui": "tsx scripts/test-auth-ui.ts",
    "test:browser": "tsx scripts/test-browser-regression.ts",
    "test:provider:playwright": "tsx scripts/test-provider-playwright.ts",
    "test:accounts:ui": "tsx scripts/test-account-ui.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
