{
  "name": "sage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "npm run dev --workspace @sage/web",
    "build": "npm run generate --workspace @sage/database && npm run build --workspace @sage/web",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @sage/web",
    "lint": "eslint .",
    "test": "tsx --test tests/environment.test.ts tests/fixtures.test.ts tests/contracts.test.ts tests/analyzer-js.test.ts tests/analyzer-php.test.ts tests/graph-foundation.test.ts tests/ui-foundation.test.ts",
    "db:generate": "npm run generate --workspace @sage/database",
    "db:migrate": "npm run migrate --workspace @sage/database",
    "worker": "tsx apps/worker/src/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:browser": "tsx scripts/browser-smoke.ts",
    "fixtures:verify": "tsx scripts/verify-fixtures.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:data",
    "test:data": "tsx --test tests/database.test.ts",
    "test:data:integration": "tsx --test tests/database.integration.ts",
    "test:ui": "tsx scripts/test-ui-foundation.ts",
    "test:graph": "tsx scripts/test-graph-foundation.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
